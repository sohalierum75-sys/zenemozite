// Prisma Schema for MovieStream
// This schema defines the database structure for caching movie/TV metadata and torrents

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  // Read from the environment so Docker deployments persist the database on
  // the /app/data volume (DATABASE_URL=file:/app/data/zenemozite.db).
  // A hardcoded url here makes Prisma ignore DATABASE_URL entirely, leaving
  // the database inside the container's ephemeral layer — wiped on every
  // deploy/recreate.
  url      = env("DATABASE_URL")
}

// MediaCache model - Stores cached movie and TV show data
model MediaCache {
  id             String   @id @default(uuid())
  tmdbId         String   @unique
  mediaType      String   // "movie" or "tv"
  imdbId         String?
  title          String
  year           String?
  rating         Float?
  runtime        Int?
  poster         String?
  backdrop       String?
  plot           String?
  genres         String?  // JSON string array
  ytTrailerCode  String?
  torrents       String?  // JSON string array of torrent objects
  download_links String?  // JSON string array of DDL objects [{ provider, quality, url }]
  telegram_files String?  // JSON string array of Telegram file objects [{ file_id, quality, size }]
  numberOfSeasons Int?    // For TV shows only
  lastUpdated    DateTime @default(now())
  createdAt      DateTime @default(now())
  
  @@index([mediaType])
  @@index([lastUpdated])
}

// Optional: ListCache model - Cache entire lists for better performance
model ListCache {
  id             String   @id @default(uuid())
  cacheKey       String   @unique  // e.g., "movies_en_page1", "tv_page2"
  data           String   // JSON string of entire list response
  lastUpdated    DateTime @default(now())
  expiresAt      DateTime
  
  @@index([cacheKey])
  @@index([expiresAt])
}

// ==============================================================================
// TELEGRAM INVISIBLE CDN & MOVIE DATABASE
// ==============================================================================

model Movie {
  id               String       @id @default(uuid())
  title            String
  sizeBytes        Float?       // total file size in bytes (set once known)
  fileName         String?      // original file name (used for Content-Disposition)
  mimeType         String?      // e.g. "video/mp4"
  magnetLink       String?      // magnet URI — stored when queued for the torrent worker
  status           String       @default("pending") // pending | queued | caching | ready | failed
  lastError        String?      // human-readable reason for the last 'failed' status
  telegramFileIds  String?      // JSON array of Telegram file_ids for ALL parts of the
                                // movie, in order — e.g. '["id_part1","id_part2"]'.
  telegram_files   String?      // JSON array of Telegram files [{ file_id: "...", quality: "1080p", size: "1.5GB" }]
  download_links   String?      // JSON array of Direct Download Links [{ provider, quality, url }]
  lastDownloadedAt DateTime     @default(now()) // touched on every download request
  createdAt        DateTime     @default(now())
  chunks           MovieChunk[]
  downloadLinks    DownloadLink[]

  variants         MovieFileVariant[]
  imports          TelegramImport[]
  rights           MovieRight[]
  downloads        MovieDownload[]
  isPublished      Boolean      @default(true)
  normalizedTitle  String?

  // --- TMDB metadata (auto-saved when movie lists are fetched & cached) ---
  tmdbId           Int?         // TMDB movie ID — unique key for upsert
  posterPath       String?      // TMDB poster path (for frontend display)
  backdropPath     String?      // TMDB backdrop path (for hero banners)
  voteAverage      Float?       // TMDB rating (0-10)
  releaseDate      String?      // release year (e.g. "2024")
  popularity       Float?       // TMDB popularity score (for sorting)
  genreIds         String?      // JSON array of TMDB genre IDs (e.g. '[28,12,16]')

  @@unique([tmdbId])
  @@index([status])
  @@index([lastDownloadedAt])
  @@index([popularity])
  @@index([normalizedTitle])
}

model MovieChunk {
  id             String   @id @default(uuid())
  movieId        String
  movie          Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  chunkIndex     Int      // 0-based order — chunks MUST be concatenated in this order
  telegramFileId    String   // Telegram file_id returned by the Local Bot API upload
  telegramMessageId Int?     // Telegram message_id in the channel for direct GramJS MTProto streaming
  chunkSize         Float    // exact byte size of this chunk
  createdAt         DateTime @default(now())

  @@unique([movieId, chunkIndex])
  @@index([movieId])
}

// Direct Download Links (DDL) model
model DownloadLink {
  id        String   @id @default(uuid())
  movieId   String?
  movie     Movie?   @relation(fields: [movieId], references: [id], onDelete: Cascade)
  tmdbId    String?  // Links directly to TMDB ID (matches movies from TMDB / MediaCache)
  provider  String   // e.g. "Google Drive", "Mega", "Pixeldrain", "Direct"
  quality   String   // e.g. "1080p", "720p", "480p", "4K"
  url       String   // The external or direct download URL
  size      String?  // Optional file size display, e.g. "1.8 GB"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([movieId])
  @@index([tmdbId])
}

// ==============================================================================
// AUTOMATED TELEGRAM IMPORT & MULTI-QUALITY DOWNLOAD SYSTEM MODELS
// ==============================================================================

// Authorized Telegram Channels with rights verification
model TelegramSource {
  id             String   @id @default(uuid())
  channelId      String   @unique  // e.g. "-1001234567890" or "@channelusername"
  channelTitle   String
  channelUsername String?
  isAuthorized   Boolean  @default(true) // explicit administrative authorization
  autoImport     Boolean  @default(true) // automatically process incoming files
  autoPublish    Boolean  @default(true) // automatically publish verified movies
  rightsStatus   String   @default("verified") // verified | pending | expired | revoked
  licenseType    String?  @default("authorized_redistribution")
  licenseNotes   String?
  lastPostAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  imports        TelegramImport[]
  rights         MovieRight[]

  @@map("telegram_sources")
  @@index([isAuthorized])
  @@index([rightsStatus])
}

// Telegram Channel Message Import Log & Queue
model TelegramImport {
  id                 String          @id @default(uuid())
  sourceChannelId    String
  source             TelegramSource? @relation(fields: [sourceChannelId], references: [channelId], onDelete: Cascade)
  messageId          Int
  updateId           Int?
  fileId             String
  fileUniqueId       String?
  fileName           String?
  fileSizeBytes      Float?
  mimeType           String?
  caption            String?
  parsedTitle        String?
  parsedYear         String?
  parsedQuality      String?         // 480p | 720p | 1080p | 4K
  codec              String?
  audioLang          String?
  resolutionVerified Boolean         @default(false)
  status             String          @default("pending") // pending | processing | verified | published | requires_review | failed | rights_expired
  errorMessage       String?
  retryCount         Int             @default(0)
  movieId            String?
  movie              Movie?          @relation(fields: [movieId], references: [id], onDelete: SetNull)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@unique([sourceChannelId, messageId])
  @@index([fileUniqueId])
  @@index([status])
  @@index([createdAt])
  @@map("telegram_imports")
}

// Multi-Quality File Variants attached to Movies (480p, 720p, 1080p, 4K)
model MovieFileVariant {
  id                   String          @id @default(uuid())
  movieId              String
  movie                Movie           @relation(fields: [movieId], references: [id], onDelete: Cascade)
  quality              String          // "480p" | "720p" | "1080p" | "4K"
  telegramFileId       String          // Telegram Local Bot API file_id
  telegramFileUniqueId String?
  telegramMessageId    Int?
  sourceChannelId      String?
  fileName             String
  fileSizeBytes        Float?
  fileSizeFormatted    String?         // e.g. "1.2 GB"
  mimeType             String?         @default("video/mp4")
  width                Int?
  height               Int?
  codec                String?         // e.g. "h264", "hevc"
  audioLanguage        String?         // e.g. "English", "Tamil"
  subtitleInfo         String?
  verifiedResolution   Boolean         @default(false)
  isAvailable          Boolean         @default(true)
  downloadCount        Int             @default(0)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  downloads            MovieDownload[]

  @@unique([movieId, quality])
  @@index([telegramFileId])
  @@index([movieId])
  @@index([quality])
  @@map("movie_file_variants")
}

// Distribution rights and license compliance tracking
model MovieRight {
  id                 String          @id @default(uuid())
  movieId            String?
  movie              Movie?          @relation(fields: [movieId], references: [id], onDelete: Cascade)
  sourceChannelId    String?
  source             TelegramSource? @relation(fields: [sourceChannelId], references: [channelId], onDelete: SetNull)
  licenseType        String          @default("authorized_redistribution")
  rightsGrantedBy    String?
  verificationStatus String          @default("verified") // verified | pending | rejected | expired
  validFrom          DateTime        @default(now())
  validUntil         DateTime?
  licenseDocumentUrl String?
  notes              String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([verificationStatus])
  @@index([movieId])
  @@map("movie_rights")
}

// Download request logging and analytics
model MovieDownload {
  id              String            @id @default(uuid())
  variantId       String?
  variant         MovieFileVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  movieId         String?
  movie           Movie?            @relation(fields: [movieId], references: [id], onDelete: SetNull)
  quality         String
  ipAddress       String?
  userAgent       String?
  bytesDownloaded Float             @default(0)
  completed       Boolean           @default(false)
  downloadedAt    DateTime          @default(now())

  @@index([downloadedAt])
  @@index([movieId])
  @@map("movie_downloads")
}
