// Prisma Schema for MovieStream
// This schema defines the database structure for caching movie/TV metadata and torrents

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  // Read from the environment so Docker deployments persist the database on
  // the /app/data volume (DATABASE_URL=file:/app/data/zenemozite.db).
  // A hardcoded url here makes Prisma ignore DATABASE_URL entirely, leaving
  // the database inside the container's ephemeral layer — wiped on every
  // deploy/recreate.
  url      = env("DATABASE_URL")
}

// MediaCache model - Stores cached movie and TV show data
model MediaCache {
  id             String   @id @default(uuid())
  tmdbId         String   @unique
  mediaType      String   // "movie" or "tv"
  imdbId         String?
  title          String
  year           String?
  rating         Float?
  runtime        Int?
  poster         String?
  backdrop       String?
  plot           String?
  genres         String?  // JSON string array
  ytTrailerCode  String?
  torrents       String?  // JSON string array of torrent objects
  numberOfSeasons Int?    // For TV shows only
  lastUpdated    DateTime @default(now())
  createdAt      DateTime @default(now())
  
  @@index([mediaType])
  @@index([lastUpdated])
}

// Optional: ListCache model - Cache entire lists for better performance
model ListCache {
  id             String   @id @default(uuid())
  cacheKey       String   @unique  // e.g., "movies_en_page1", "tv_page2"
  data           String   // JSON string of entire list response
  lastUpdated    DateTime @default(now())
  expiresAt      DateTime
  
  @@index([cacheKey])
  @@index([expiresAt])
}

// ==============================================================================
// TELEGRAM INVISIBLE CDN
// Movies are split into byte-range chunks (<= ~1.9GB each, configurable) and
// each chunk is uploaded to a private Telegram channel via the Local Bot API.
// The download route streams all chunks sequentially into a single HTTP
// response so the user receives one continuous file — Telegram is invisible.
// Byte sizes are stored as Float (exact up to ~9 petabytes, JSON-safe).
// ==============================================================================

model Movie {
  id               String       @id @default(uuid())
  title            String
  sizeBytes        Float?       // total file size in bytes (set once known)
  fileName         String?      // original file name (used for Content-Disposition)
  mimeType         String?      // e.g. "video/mp4"
  magnetLink       String?      // magnet URI — stored when queued for the torrent worker
  status           String       @default("pending") // pending | queued | caching | ready | failed
  lastError        String?      // human-readable reason for the last 'failed' status
  telegramFileIds  String?      // JSON array of Telegram file_ids for ALL parts of the
                                // movie, in order — e.g. '["id_part1","id_part2"]'.
                                // Written by the chunker when every part is uploaded;
                                // lets the API/frontend handle multi-part downloads
                                // without re-querying the MovieChunk rows.
  lastDownloadedAt DateTime     @default(now()) // touched on every download request
  createdAt        DateTime     @default(now())
  chunks           MovieChunk[]

  // --- TMDB metadata (auto-saved when movie lists are fetched & cached) ---
  tmdbId           Int?         // TMDB movie ID — unique key for upsert
  posterPath       String?      // TMDB poster path (for frontend display)
  backdropPath     String?      // TMDB backdrop path (for hero banners)
  voteAverage      Float?       // TMDB rating (0-10)
  releaseDate      String?      // release year (e.g. "2024")
  popularity       Float?       // TMDB popularity score (for sorting)
  genreIds         String?      // JSON array of TMDB genre IDs (e.g. '[28,12,16]')

  @@unique([tmdbId])
  @@index([status])
  @@index([lastDownloadedAt])
  @@index([popularity])
}

model MovieChunk {
  id             String   @id @default(uuid())
  movieId        String
  movie          Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  chunkIndex     Int      // 0-based order — chunks MUST be concatenated in this order
  telegramFileId String   // Telegram file_id returned by the Local Bot API upload
  chunkSize      Float    // exact byte size of this chunk
  createdAt      DateTime @default(now())

  @@unique([movieId, chunkIndex])
  @@index([movieId])
}
