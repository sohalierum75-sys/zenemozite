// Prisma Schema for MovieStream
// This schema defines the database structure for caching movie/TV metadata and torrents

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./moviestream.db"
}

// MediaCache model - Stores cached movie and TV show data
model MediaCache {
  id             String   @id @default(uuid())
  tmdbId         String   @unique
  mediaType      String   // "movie" or "tv"
  imdbId         String?
  title          String
  year           String?
  rating         Float?
  runtime        Int?
  poster         String?
  backdrop       String?
  plot           String?
  genres         String?  // JSON string array
  ytTrailerCode  String?
  torrents       String?  // JSON string array of torrent objects
  numberOfSeasons Int?    // For TV shows only
  lastUpdated    DateTime @default(now())
  createdAt      DateTime @default(now())
  
  @@index([mediaType])
  @@index([lastUpdated])
}

// Optional: ListCache model - Cache entire lists for better performance
model ListCache {
  id             String   @id @default(uuid())
  cacheKey       String   @unique  // e.g., "movies_en_page1", "tv_page2"
  data           String   // JSON string of entire list response
  lastUpdated    DateTime @default(now())
  expiresAt      DateTime
  
  @@index([cacheKey])
  @@index([expiresAt])
}

// ==============================================================================
// HYBRID STORAGE CACHE
// Routes cached movie files to Telegram (<= 2GB, unlimited retention) or
// Google Drive (> 2GB, multi-account load balancing + LRU auto-cleanup).
// Byte sizes are stored as Float (exact up to ~9 petabytes, JSON-safe).
// ==============================================================================

model Movie {
  id               String        @id @default(uuid())
  title            String
  size             Float         // size of the largest file in the torrent (bytes)
  fileName         String?
  mimeType         String?
  magnetLink       String?       // magnet of the torrent — stored when the movie is queued for caching
  telegramFileId   String?       // Telegram route (size <= 2GB) — no cleanup needed
  driveFileId      String?       // Google Drive route (size > 2GB)
  driveAccountId   String?       // which DriveAccount holds the file
  driveAccount     DriveAccount? @relation(fields: [driveAccountId], references: [id])
  lastDownloadedAt DateTime      @default(now()) // touched on EVERY link request (LRU)
  cachedAt         DateTime      @default(now())

  @@index([lastDownloadedAt])
  @@index([driveAccountId])
}

model DriveAccount {
  id          String   @id @default(uuid())
  credentials String   // service-account JSON (stringified) or path to the key file
  email       String?  // client_email — readable identifier for logs
  totalSpace  Float    // account quota in bytes
  usedSpace   Float    @default(0)
  movies      Movie[]

  @@unique([email])
}
