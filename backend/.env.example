# Prisma Database Configuration
DATABASE_URL="file:./prisma/moviestream.db"

# Server Configuration
PORT=5000
NODE_ENV=development

# TMDB API Configuration
# Get your free API key from: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Cache Configuration
CACHE_DURATION_HOURS=24

# ==============================================================================
# Telegram Invisible CDN (chunked uploads + sequential streaming downloads)
# ==============================================================================

# Telegram Local Bot API server (https://github.com/tdlib/telegram-bot-api)
# The local server is what allows 2GB uploads (cloud API bots are limited to 50MB)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=-1001234567890
TELEGRAM_LOCAL_API_URL=http://localhost:8081
# Telegram MTProto Userbot (GramJS) configuration for Direct Streaming & Seeking
TELEGRAM_API_ID=23271365
TELEGRAM_API_HASH=59a8393f1c17083798b42333d16ff224
TELEGRAM_STRING_SESSION= # Optional: Userbot session string. If empty, MTProto connects using TELEGRAM_BOT_TOKEN
# Hard per-upload limit (Local Bot API max is 2GB)
TELEGRAM_MAX_GB=2
# Chunk size for splitting large files (must be < TELEGRAM_MAX_GB)
TELEGRAM_CHUNK_GB=0.5

# ==============================================================================
# Telegram Automated Movie Import & Multi-Quality Download System
# ==============================================================================
# Secret token for Telegram Bot Webhook security verification
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_here
# Secret key for generating cryptographically signed download URLs
DOWNLOAD_SIGNING_SECRET=your_download_signing_secret_here
# Maximum concurrent streaming downloads per client IP
MAX_CONCURRENT_DOWNLOADS=4
# Nginx X-Accel-Redirect offloading (true if using Nginx internal download proxy)
USE_X_ACCEL_REDIRECT=false
