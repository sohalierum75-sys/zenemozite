# Prisma Database Configuration
DATABASE_URL="file:./prisma/moviestream.db"

# Server Configuration
PORT=5000
NODE_ENV=development

# TMDB API Configuration
# Get your free API key from: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Cache Configuration
CACHE_DURATION_HOURS=24

# ==============================================================================
# Hybrid Storage Cache (Telegram <= 2GB + Google Drive > 2GB + LRU cleanup)
# Storage index lives in Prisma (Movie + DriveAccount tables), not MongoDB.
# ==============================================================================

# Telegram Local Bot API server (https://github.com/tdlib/telegram-bot-api)
# The local server is what allows 2GB uploads (cloud API bots are limited to 50MB)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=-1001234567890
TELEGRAM_LOCAL_API_URL=http://localhost:8081
TELEGRAM_MAX_GB=2

# Google Drive service accounts — EITHER a JSON array of key objects:
#   GDRIVE_CREDENTIALS_JSON=[{"client_email":"...","private_key":"..."},{...}]
# OR a folder containing the .json key files:
GDRIVE_CREDENTIALS_JSON=
GDRIVE_CREDENTIALS_DIR=
GDRIVE_FOLDER_ID=
GDRIVE_ACCOUNT_LIMIT_GB=15
GDRIVE_FREE_BUFFER_MB=100

# LRU auto-cleanup (Google Drive only)
LRU_MAX_EVICTIONS=50
LRU_QUOTA_SETTLE_MS=3000
