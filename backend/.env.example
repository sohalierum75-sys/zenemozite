# Prisma Database Configuration
DATABASE_URL="file:./prisma/moviestream.db"

# Server Configuration
PORT=5000
NODE_ENV=development

# TMDB API Configuration
# Get your free API key from: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Cache Configuration
CACHE_DURATION_HOURS=24

# ==============================================================================
# Telegram Invisible CDN (chunked uploads + sequential streaming downloads)
# ==============================================================================

# Telegram Local Bot API server (https://github.com/tdlib/telegram-bot-api)
# The local server is what allows 2GB uploads (cloud API bots are limited to 50MB)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=-1001234567890
TELEGRAM_LOCAL_API_URL=http://localhost:8081
# Hard per-upload limit (Local Bot API max is 2GB)
TELEGRAM_MAX_GB=2
# Chunk size for splitting large files (must be < TELEGRAM_MAX_GB)
TELEGRAM_CHUNK_GB=1.9
