# ===========================================
# MovieStream Environment Variables
# Copy this file to .env and fill in your values
# ===========================================

# TMDB API Configuration
# Get your API key from: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Server Configuration
PORT=5000
NODE_ENV=production

# Database Configuration (for Docker, this is set automatically)
DATABASE_URL=file:./prisma/moviestream.db

# Cache Configuration
CACHE_DURATION_HOURS=24

# Telegram CDN (required for the background CDN caching worker)
# Private Telegram channel used as the movie file cache backend
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
# Optional: Local Bot API server URL (default http://telegram-api:8081 when
# using the bundled telegram-api service; the backend appends /bot<token>)
TELEGRAM_LOCAL_API_URL=http://telegram-api:8081

# Telegram Local Bot API server (required to run the telegram-api container)
# Values from https://my.telegram.org -> API development tools
# NOTE: these are committed per project decision — consider moving them to
# GitHub Actions secrets / VPS-side .env if the repo ever becomes sensitive.
TELEGRAM_LOCAL_API_URL=http://telegram-api:8081
TELEGRAM_API_ID=23271365
TELEGRAM_API_HASH=59a8393f1c17083798b42333d16ff224

# Low-RAM stability tuning (1-2GB VPS)
# Chunk size in GB for Telegram uploads (max 2, hard-clamped). 0.5 keeps
# upload buffers small so the container never gets OOM-killed (Error 521).
TELEGRAM_CHUNK_GB=0.5
# Max simultaneous torrent downloads in the CDN worker (RAM-heavy)
CDN_MAX_CONCURRENT=1
# RAM cap (MB) for the upload reader's in-memory buffer. The file streams to
# Telegram in pieces of this size and is NEVER loaded into RAM as a whole.
TELEGRAM_HWM_MB=4

# Docker Deployment
IMAGE_NAME=ghcr.io/yourusername/moviestream:latest
